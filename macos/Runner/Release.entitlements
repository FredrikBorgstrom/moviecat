<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Direct-download build: not sandboxed, so "Find movies automatically" can
	     search all drives. The Mac App Store build is re-signed with
	     AppStore.entitlements by appstore/build.sh. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
